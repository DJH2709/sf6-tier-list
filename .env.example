# Leave these blank to run in demo mode (votes saved in your browser only).
NEXT_PUBLIC_SUPABASE_URL=
# Your publishable key (sb_publishable_...). Older projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Lists a rank band needs before its results show.
NEXT_PUBLIC_MIN_LISTS=20
# Sign-in buttons, comma separated. Only list providers switched on in Supabase.
# Options: discord, google, kakao, x (and custom:<id> for a custom provider). Default: discord
NEXT_PUBLIC_AUTH_PROVIDERS=discord
